<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sebra82 // Secure Regime Console</title>
    <!-- Presentation layer stylesheet link -->
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <div class="dashboard-frame">
        <div class="sys-header">
            <span class="header-tag">M4P-V6.99 // DTSA_18_USC_1836_SECURE_REGIME</span>
            <span class="lock-badge" id="lockState">LOCKED</span>
        </div>

        <div class="visualizer-container">
            <canvas id="constellationCanvas"></canvas>
            <div class="wave-equation-bar" id="waveEq">Ψ(t) = √([99.45%])|0⟩ // ΔE: 0.000 eV</div>
        </div>

        <div class="vault-gateway-panel">
            <div class="gateway-header">
                <span>SYS_VAULT_GATEWAY</span>
                <span class="gateway-status" id="gateText">Key needed.</span>
            </div>
            <div class="terminal-row">
                <input type="password" class="terminal-input" id="vaultKey" autocomplete="off">
                <button class="terminal-btn" id="enterBtn">ENTER</button>
            </div>
        </div>

        <div class="metrics-block">
            <div class="metric-item" id="entropyCard">
                <span class="m-label">ENTANGLEMENT ENTROPY</span>
                <span class="m-val hl-green" id="entropyVal">0.9627 S_vN</span>
            </div>
            <div class="metric-item" id="phaseCard">
                <span class="m-label">PHASE PROPAGATION</span>
                <span class="m-val hl-green" id="phaseVal">0.0040 r/s</span>
            </div>
            <div class="metric-item" id="subspaceCard">
                <span class="m-label">HILBERT SUBSPACE</span>
                <span class="m-val hl-cyan" id="subspaceVal">2¹⁰⁰ VIRTUAL</span>
            </div>
            <div class="metric-item" id="meshCard">
                <span class="m-label">TENSOR MESH SYNC</span>
                <span class="m-val hl-cyan" id="meshSyncText">OFFLINE</span>
            </div>
        </div>

        <div class="pipeline-card">
            <span class="hl-cyan">QTR_1 // HYDRO</span>
            <span class="pipe-status" id="pipe1">[LOCKED]</span>
        </div>
        <div class="pipeline-card">
            <span class="hl-cyan">QTR_2 // XD_OBF</span>
            <span class="pipe-status" id="pipe2">[LOCKED]</span>
        </div>
    </div>

    <!-- Modular logic script loading modules -->
    <script src="physics.js"></script>
    <script src="glitch.js"></script>
</body>
</html>
